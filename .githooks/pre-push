#!/bin/sh
# Antes de subir: mismas comprobaciones que exige CLAUDE.md para dar un paso por terminado.
# Se activa con `npm install` (script "prepare"). Se puede saltar con `git push --no-verify`;
# la comprobación que no se puede saltar será la CI del paso 10.
set -e

echo "pre-push: typecheck, lint y tests…"
npm run --silent typecheck
npm run --silent lint
npm test --silent
echo "pre-push: todo en verde."
