{
  "permissions": {
    "defaultMode": "plan",
    "deny": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git -C * commit *)",
      "Bash(git -C * push *)",
      "Bash(git checkout *)",
      "Bash(git restore *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(cat .env*)",
      "Bash(source .env*)",
      "Bash(grep * .env*)"
    ]
  }
}
