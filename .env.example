# Copia este archivo a .env y rellena los valores. .env nunca se sube al repositorio.

# --- Conexión ---------------------------------------------------------------

# URL de la organización, p. ej. https://dev.azure.com/mi-organizacion
AZDO_ORG_URL=

# Nombre del proyecto de Azure DevOps
AZDO_PROJECT=

# Token de SOLO LECTURA. Lo usa la recogida de datos (src/).
AZDO_PAT=

# --- Solo para sembrar el proyecto demo (scripts/seed-demo.ts) --------------
# Nunca crees estos tokens en una organización real.

# Tu token de LECTURA Y ESCRITURA.
AZDO_PAT_SEED=

# Opcional: token de lectura y escritura de una SEGUNDA cuenta (el "compañero").
# Sin él no se crean los casos K y L (PRs de otra persona donde eres revisor).
AZDO_PAT_TEAMMATE=

# Opcional: tu correo en Azure DevOps. Solo hace falta si el seed no puede averiguarlo solo.
AZDO_USER_EMAIL=

# --- Reglas del informe (ver docs/glosario.md) ------------------------------

# Días para considerar una PR envejecida y una tarea estancada.
AGED_PR_DAYS=3
STALE_TASK_DAYS=3

